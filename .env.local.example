# =============================================================
#  NIKUNJ SAKHI — Environment Variables
#  Copy this file to .env.local and fill all values
# =============================================================

# --------------- SITE ---------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --------------- SANITY CMS ---------------
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your_sanity_api_write_token

# --------------- MONGODB ---------------
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/nikunj-sakhi?retryWrites=true&w=majority

# --------------- JWT AUTH ---------------
JWT_SECRET=your_very_long_random_jwt_secret_min_64_chars
# Optional: separate key used to hash stored OTP codes and derive delivery OTPs (falls back to JWT_SECRET).
OTP_HASH_SECRET=
# Session lifetime in seconds (default 604800 = 7 days if unset). NOTE: must be a number
# of seconds, not a duration string like "7d".
JWT_EXPIRES_IN_SECONDS=604800

# --------------- RAZORPAY (legacy — settlement/refunds for pre-existing orders only) ---------------
# Cashfree is now the sole gateway offered at checkout (see CASHFREE section below). These
# keys are still required so `/api/payment/verify`, `/api/payment/webhook`, and admin refund
# lookups keep working for orders that were paid via Razorpay before the Cashfree migration.
# Do not remove until all historical Razorpay orders are fully settled/refunded.
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Webhook secret configured in Razorpay Dashboard → Webhooks for /api/payment/webhook
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# --------------- GUEST-CHECKOUT PHONE VERIFICATION (MSG91 SMS) ---------------
# Used ONLY to verify the phone on guest orders. SMS is NOT a login method (login = Google, email+password, WhatsApp OTP).
# Guest verification also works over WhatsApp when it is configured below.
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_template_id

# Google Analytics 4 measurement ID (loads only after cookie consent), e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Google Search Console site-verification meta tag value (Search Console -> Settings ->
# Ownership verification -> HTML tag -> copy only the `content` attribute value).
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# --------------- EMAIL (Resend — required for password reset / transactional email) ---------------
# https://resend.com -> API Keys. EMAIL_FROM must use a domain verified in Resend
# (Resend dashboard -> Domains). Both must be set for sendEmail()/isEmailConfigured()
# to return true; otherwise email sending is silently skipped (callers degrade gracefully).
RESEND_API_KEY=
EMAIL_FROM=Nikunj Sakhi <no-reply@nikunjsakhi.com>

# --------------- GOOGLE SIGN-IN (OAuth 2.0) ---------------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
# Authorized redirect URI: {NEXT_PUBLIC_SITE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --------------- WHATSAPP CLOUD API (automatic customer order messages) ---------------
# Meta for Developers -> WhatsApp -> API Setup. Leave blank to disable automatic messages.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved template with 4 body variables: {{1}} name, {{2}} order ID, {{3}} status, {{4}} tracking link
WHATSAPP_ORDER_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
# Shared secret sent by the Sanity webhook (header x-webhook-secret) to /api/webhooks/order-status
SANITY_WEBHOOK_SECRET=

# --------------- CLERK (email + Google sign-in, and WhatsApp-OTP session bridge) ---------------
# https://dashboard.clerk.com -> your app -> API Keys. Leave both blank to keep using the
# existing JWT-cookie auth system unchanged (requireAuth/requireAdmin are untouched).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --------------- WHATSAPP OTP LOGIN (Meta WhatsApp Cloud API) ---------------
# Reuses WHATSAPP_TOKEN / WHATSAPP_PHONE_NUMBER_ID above. Requires an approved Meta
# "Authentication" template (category AUTHENTICATION) with a single {{1}} OTP code variable.
# Meta for Developers -> WhatsApp -> Message Templates -> create Authentication template.
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_OTP_TEMPLATE_LANG=en_US
# Optional: approved template for the delivery OTP (one {{1}} body param = code). Falls back to WHATSAPP_OTP_TEMPLATE.
WHATSAPP_DELIVERY_OTP_TEMPLATE=
# Set to "false" to omit the one-tap "Copy Code" quick-reply button some template configs omit.
WHATSAPP_OTP_BUTTON=true

# --------------- WHATSAPP DELIVERY-RECEIPT WEBHOOK (Meta Cloud API) ---------------
# Meta App Dashboard -> WhatsApp -> Configuration: callback URL https://<site>/api/webhooks/whatsapp,
# verify token = WHATSAPP_WEBHOOK_VERIFY_TOKEN, subscribe to "messages". Signature = HMAC-SHA256 with the App Secret.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Hours a delivery PIN stays valid after the order is marked out for delivery (default 72).
DELIVERY_PIN_TTL_HOURS=72

# --------------- CASHFREE PAYMENTS (sole active checkout gateway) ---------------
# https://merchant.cashfree.com -> Developers -> API Keys. Required for checkout to work —
# without these, online-payment checkout returns 503 (Cash on Delivery still works).
# Use the TEST (sandbox) key pair locally and in preview deployments; put the PRODUCTION key
# pair ONLY in the production host's secret store. Never commit either.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# "SANDBOX" (default) or "PRODUCTION" — must match the key pair above (test keys + SANDBOX,
# production keys + PRODUCTION). Never set to PRODUCTION until sandbox testing passes.
# (CASHFREE_ENV is accepted as an alias.)
CASHFREE_ENVIRONMENT=SANDBOX
# Optional: pin Cashfree's x-api-version header (e.g. 2025-01-01). Leave empty to use the
# version bundled with the installed cashfree-pg SDK.
CASHFREE_API_VERSION=
# Webhook: Cashfree Dashboard -> Developers -> Webhooks (configure Test and Production separately)
#   URL:    https://<your-domain>/api/payment/cashfree/webhook
#   Events: PAYMENT_SUCCESS_WEBHOOK, PAYMENT_FAILED_WEBHOOK, PAYMENT_USER_DROPPED_WEBHOOK
# Signatures are verified with CASHFREE_SECRET_KEY over the raw body — there is no separate
# webhook secret. The return URL (<NEXT_PUBLIC_SITE_URL>/confirmation) and notify_url are
# built from NEXT_PUBLIC_SITE_URL, which must be your https:// domain in production
# (notify_url is omitted when the site URL is not https, e.g. http://localhost).
# Deprecated / unused by the current checkout page (which is Cashfree-only regardless of this
# flag) — kept only for backward compatibility with older deployments. Safe to leave as "false".
NEXT_PUBLIC_CASHFREE_ENABLED=false

# --------------- CASHFREE PAYOUTS (refunds for COD / manual payments) ---------------
# Optional. Online payments are always refunded back to source with the keys above. For COD
# orders the customer shares a UPI ID / bank account on /track-order and, once you approve the
# refund in Studio -> Orders Dashboard, it is sent with Cashfree Payouts. Without these keys the
# refund switches to "manual": pay from your UPI/bank app and record the UTR with "Mark refunded".
# Payouts keys are separate from the PG keys: merchant.cashfree.com -> Payouts -> Developers.
# Payouts also requires either a whitelisted server IP or the Payouts public key (2FA) below.
# Uses CASHFREE_ENVIRONMENT (SANDBOX/PRODUCTION).
CASHFREE_PAYOUT_CLIENT_ID=
CASHFREE_PAYOUT_CLIENT_SECRET=
# PEM text (\n-escaped) or base64 of the .pem file. Leave empty when using IP whitelisting.
CASHFREE_PAYOUT_PUBLIC_KEY=

# --------------- WEBSITE ANALYTICS (Studio -> Analytics) ---------------
# Footfall is recorded only in production (uses SANITY_API_TOKEN). Set to 1 to also record
# visits from `npm run dev` (they go to the same Sanity dataset).
ANALYTICS_IN_DEV=