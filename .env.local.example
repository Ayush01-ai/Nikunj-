# =============================================================
#  NIKUNJ SAKHI — Environment Variables
#  Copy this file to .env.local and fill all values
# =============================================================

# --------------- SITE ---------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --------------- SANITY CMS ---------------
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your_sanity_api_write_token

# --------------- MONGODB ---------------
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/nikunj-sakhi?retryWrites=true&w=majority

# --------------- JWT AUTH ---------------
JWT_SECRET=your_very_long_random_jwt_secret_min_64_chars
JWT_REFRESH_SECRET=your_refresh_token_secret_min_64_chars
JWT_EXPIRES_IN=7d

# --------------- CLOUDINARY ---------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# --------------- RAZORPAY ---------------
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
# Webhook secret configured in Razorpay Dashboard → Webhooks for /api/payment/webhook
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# --------------- OTP (MSG91 / Firebase) ---------------
# Option A: MSG91
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_template_id

# Option B: Firebase (for phone OTP)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}

# --------------- ADMIN ---------------
ADMIN_EMAIL=admin@nikunjsakhi.com
ADMIN_PASSWORD_HASH=bcrypt_hashed_password_here

# --------------- OPTIONAL: SMTP (Order confirmation email) ---------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=Nikunj Sakhi <no-reply@nikunjsakhi.com>

# --------------- WHATSAPP ---------------
NEXT_PUBLIC_WHATSAPP_NUMBER=919XXXXXXXXX

# --------------- INSTAGRAM ---------------
NEXT_PUBLIC_INSTAGRAM_HANDLE=jewelleryCollection.7

# Google Analytics 4 measurement ID (loads only after cookie consent), e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# --------------- EMAIL (Resend - password reset emails) ---------------
# https://resend.com -> API Keys. EMAIL_FROM above must use a domain verified in Resend.
RESEND_API_KEY=

# --------------- GOOGLE SIGN-IN (OAuth 2.0) ---------------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
# Authorized redirect URI: {NEXT_PUBLIC_SITE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --------------- WHATSAPP CLOUD API (automatic customer order messages) ---------------
# Meta for Developers -> WhatsApp -> API Setup. Leave blank to disable automatic messages.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved template with 4 body variables: {{1}} name, {{2}} order ID, {{3}} status, {{4}} tracking link
WHATSAPP_ORDER_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
# Shared secret sent by the Sanity webhook (header x-webhook-secret) to /api/webhooks/order-status
SANITY_WEBHOOK_SECRET=