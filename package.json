{
  "name": "nikunj-sakhi",
  "version": "1.0.0",
  "description": "Nikunj Sakhi – Divine God Ornaments | Production-grade devotional e-commerce",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node -e \"require('fs').rmSync('.next/cache/fetch-cache',{recursive:true,force:true})\"",
    "build": "next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "lint": "eslint .",
    "studio": "sanity dev",
    "sanity": "sanity dev",
    "sanity:build": "sanity build",
    "sanity:deploy": "sanity deploy",
    "seed": "node ./scripts/seed.mjs",
    "db:check": "node ./scripts/check-mongodb.mjs",
    "otp:peek": "node ./scripts/peek-otp.mjs",
    "import:products": "node ./scripts/import-products.mjs",
    "migrate:taxonomy": "node ./scripts/migrate-taxonomy.mjs",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "audit": "npm run dev & npx wait-on http://localhost:3000 && lighthouse http://localhost:3000 --output=html --output-path=./audit/report.html",
    "test:e2e": "playwright test"
  },
  "dependencies": {
