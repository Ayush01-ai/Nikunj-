{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  // Must match the Worker name in the Cloudflare dashboard (Workers Builds enforces this).
  "name": "nikunj",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Variables/secrets are managed in the dashboard; never delete them on deploy.
  "keep_vars": true,
  // Match the existing dashboard values so deploys don't change URL exposure.
  "workers_dev": false,
  "preview_urls": false,
  // Runs before every `wrangler deploy` (incl. `opennextjs-cloudflare deploy` and Workers Builds):
  // publishes prerendered pages as static assets so they load without spending Worker CPU.
  "build": {
    "command": "node scripts/static-html-assets.mjs"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      // Must equal "name" above.
      "service": "nikunj"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
