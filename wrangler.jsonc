{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  // Must match the Worker name in the Cloudflare dashboard (Workers Builds enforces this).
  "name": "nikunj",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Variables/secrets are managed in the dashboard; never delete them on deploy.
  "keep_vars": true,
  // Match the existing dashboard values so deploys don't change URL exposure.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      // Must equal "name" above.
      "service": "nikunj"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  // Same namespace serves the page cache and the tag cache (distinct key prefixes).
  "kv_namespaces": [
    { "binding": "NEXT_INC_CACHE_KV", "id": "4cc79da97baf44d48b45dc71a787a6ee" },
    { "binding": "NEXT_TAG_CACHE_KV", "id": "4cc79da97baf44d48b45dc71a787a6ee" }
  ],
  "observability": {
    "enabled": true
  }
}
